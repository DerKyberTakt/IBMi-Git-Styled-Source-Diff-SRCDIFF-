/*******************************************************************/
/* BUILD - create every SRCDIFF object                             */
/*                                                                 */
/*   CALL BUILD PARM('MYLIB' 'MYSRCLIB')                           */
/*     &LIB    = library that receives the objects                 */
/*     &SRCLIB = library holding QDDSSRC QRPGLESRC QCLLESRC QCMDSRC*/
/*               (may be the same library)                         */
/*                                                                 */
/* Compile this program first:                                     */
/*   CRTBNDCL PGM(MYLIB/BUILD) SRCFILE(MYSRCLIB/QCLLESRC)          */
/*******************************************************************/
             PGM        PARM(&LIB &SRCLIB)
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(256)
             DCL        VAR(&MSGID)  TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGF)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGFLIB) TYPE(*CHAR) LEN(10)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

/* The /COPY of SRCDIFF_H is found through the library list        */
             ADDLIBLE   LIB(&SRCLIB)
             MONMSG     MSGID(CPF2103)
             ADDLIBLE   LIB(&LIB)
             MONMSG     MSGID(CPF2103)

/* Display files: 27x132 and the 24x80 fallback                    */
             CRTDSPF    FILE(&LIB/SRCDIFFD) SRCFILE(&SRCLIB/QDDSSRC) +
                          RSTDSP(*YES) REPLACE(*YES)
             CRTDSPF    FILE(&LIB/SRCDIFFD8) SRCFILE(&SRCLIB/QDDSSRC) +
                          RSTDSP(*YES) REPLACE(*YES)

/* Diff engine (embedded SQL, needs RPGPPOPT(*LVL2) for /IF DEFINED) */
             CRTSQLRPGI OBJ(&LIB/SRCDIFFM) SRCFILE(&SRCLIB/QRPGLESRC) +
                          OBJTYPE(*MODULE) OPTION(*SYS) COMMIT(*NONE) +
                          RPGPPOPT(*LVL2) DBGVIEW(*SOURCE) +
                          REPLACE(*YES)

/* Viewer                                                          */
             CRTRPGMOD  MODULE(&LIB/SRCDIFFR) +
                          SRCFILE(&SRCLIB/QRPGLESRC) DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             CRTPGM     PGM(&LIB/SRCDIFFR) MODULE(&LIB/SRCDIFFR +
                          &LIB/SRCDIFFM) ACTGRP(*NEW) REPLACE(*YES)

/* Command and its CPP                                             */
             CRTBNDCL   PGM(&LIB/SRCDIFFC) SRCFILE(&SRCLIB/QCLLESRC) +
                          DBGVIEW(*SOURCE) REPLACE(*YES)
             CRTCMD     CMD(&LIB/SRCDIFF) PGM(&LIB/SRCDIFFC) +
                          SRCFILE(&SRCLIB/QCMDSRC) REPLACE(*YES)

/* Test driver (optional - skipped silently if its source is absent) */
             CHKOBJ     OBJ(&SRCLIB/QDDSSRC) OBJTYPE(*FILE) +
                          MBR(SRCDIFFTP)
             MONMSG     MSGID(CPF9815) EXEC(GOTO CMDLBL(DONE))
             CRTPF      FILE(&LIB/SRCDIFFTP) SRCFILE(&SRCLIB/QDDSSRC) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF7302 CPF5813)
             CRTSQLRPGI OBJ(&LIB/SRCDIFFT) SRCFILE(&SRCLIB/QRPGLESRC) +
                          OBJTYPE(*MODULE) OPTION(*SYS) COMMIT(*NONE) +
                          RPGPPOPT(*LVL2) DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             CRTPGM     PGM(&LIB/SRCDIFFT) MODULE(&LIB/SRCDIFFT +
                          &LIB/SRCDIFFM) ACTGRP(*NEW) REPLACE(*YES)

 DONE:       SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('SRCDIFF built into' *BCAT &LIB) +
                          MSGTYPE(*COMP)
             RETURN

 ERROR:      RCVMSG     MSGTYPE(*EXCP) RMV(*NO) MSGDTA(&MSGDTA) +
                          MSGID(&MSGID) MSGF(&MSGF) SNDMSGFLIB(&MSGFLIB)
             MONMSG     MSGID(CPF0000)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGFLIB/&MSGF) +
                          MSGDTA(&MSGDTA) MSGTYPE(*ESCAPE)
             MONMSG     MSGID(CPF0000)
             ENDPGM
