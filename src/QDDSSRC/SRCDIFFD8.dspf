     A*****************************************************************
     A* SRCDIFFD8 - SRCDIFF display: git-style unified compare, 24x80
     A* Generated by tools/gen_dds.py - edit the generator, not this file
     A* Subfile colours: 31 deleted (red) 32 added (green) 33 hunk
     A*   header (blue) 34 stats (yellow) 35 context (white)
     A* 27 page down 28 page up 29 SFLEND 30 show subfile (off = clear)
     A*****************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CF03(03 'Exit')
     A                                      CF06(06 'Whole/Hunks')
     A                                      CF10(10 'Next change')
     A                                      CF11(11 'Previous change')
     A                                      CF12(12 'Cancel')
     A                                      CF14(14 'Ignore blanks')
     A                                      CF16(16 'Top')
     A                                      CF17(17 'Bottom')
     A                                      CF19(19 'Shift left')
     A                                      CF20(20 'Shift right')
     A                                      PAGEDOWN(27 'Next page')
     A                                      PAGEUP(28 'Previous page')
     A                                      PRINT
     A                                      INDARA
     A*---------------------------------------------------------------
     A* Subfile record: one diff row
     A*---------------------------------------------------------------
     A          R SFL8                      SFL
     A            MK             1A  O  6  2
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            OSEQ           7A  O  6  4
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            NSEQ           7A  O  6 12
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            TXT           61A  O  6 20
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A*---------------------------------------------------------------
     A* Subfile control: header rows 1-5, page rows 6-21, More... 22
     A*---------------------------------------------------------------
     A          R SFLCTL8                   SFLCTL(SFL8)
     A                                      SFLSIZ(0016)
     A                                      SFLPAG(0016)
     A                                      OVERLAY
     A  30                                  SFLDSP
     A                                      SFLDSPCTL
     A N30                                  SFLCLR
     A  29                                  SFLEND(*MORE)
     A                                  1  2'SRCDIFF'
     A                                      COLOR(BLU)
     A                                  1 30'Source Member Compare'
     A                                      DSPATR(HI)
     A                                  1 63DATE
     A                                      EDTCDE(Y)
     A                                      COLOR(BLU)
     A                                  1 72TIME
     A                                      COLOR(BLU)
     A                                  2  2'Old:'
     A                                      COLOR(BLU)
     A            OLDNAM        33A  O  2  7
     A                                      COLOR(RED)
     A                                  2 42'Context:'
     A                                      COLOR(BLU)
     A            CTXTXT         5A  O  2 51
     A                                  2 58'Ign blanks:'
     A                                      COLOR(BLU)
     A            IGNTXT         3A  O  2 70
     A                                  3  2'New:'
     A                                      COLOR(BLU)
     A            NEWNAM        33A  O  3  7
     A                                      COLOR(GRN)
     A            STATS         36A  O  3 42
     A                                      COLOR(YLW)
     A                                  4  2'Go to seq'
     A                                      COLOR(BLU)
     A            GOTOSEQ        6Y 2B  4 12EDTCDE(4)
     A                                      DSPATR(UL)
     A            POSTXT        40A  O  4 40
     A                                      COLOR(BLU)
     A                                  5  7'Old#    New# Source'
     A                                      COLOR(BLU)
     A                                      DSPATR(UL)
     A*---------------------------------------------------------------
     A* Footer: message line and function keys
     A*---------------------------------------------------------------
     A          R FOOTER8
     A                                      OVERLAY
     A            MSG           78A  O 23  2
     A                                      COLOR(PNK)
     A                                 24  2'F3=Exit F6=All F10/F11=Next/Prev F-
     A                                      14=Blanks F16/F17=Top/Bot F19/F20=-
     A                                      Shift'
     A                                      COLOR(BLU)
