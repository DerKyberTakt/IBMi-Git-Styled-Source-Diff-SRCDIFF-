     A*****************************************************************
     A* SRCDIFFD  - SRCDIFF display: git-style unified compare, 27x132
     A* Generated by tools/gen_dds.py - edit the generator, not this file
     A* Subfile colours: 31 deleted (red) 32 added (green) 33 hunk
     A*   header (blue) 34 stats (yellow) 35 context (white)
     A* 27 page down 28 page up 29 SFLEND 30 show subfile (off = clear)
     A*****************************************************************
     A                                      DSPSIZ(27 132 *DS4)
     A                                      CF03(03 'Exit')
     A                                      CF06(06 'Whole/Hunks')
     A                                      CF10(10 'Next change')
     A                                      CF11(11 'Previous change')
     A                                      CF12(12 'Cancel')
     A                                      CF14(14 'Ignore blanks')
     A                                      CF16(16 'Top')
     A                                      CF17(17 'Bottom')
     A                                      PAGEDOWN(27 'Next page')
     A                                      PAGEUP(28 'Previous page')
     A                                      PRINT
     A                                      INDARA
     A*---------------------------------------------------------------
     A* Subfile record: one diff row
     A*---------------------------------------------------------------
     A          R SFL1                      SFL
     A            MK             1A  O  6  2
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            OSEQ           7A  O  6  4
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            NSEQ           7A  O  6 12
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A            TXT          113A  O  6 20
     A  31                                  COLOR(RED)
     A  32                                  COLOR(GRN)
     A  33                                  COLOR(BLU)
     A  34                                  COLOR(YLW)
     A  35                                  COLOR(WHT)
     A*---------------------------------------------------------------
     A* Subfile control: header rows 1-5, page rows 6-24, More... 25
     A*---------------------------------------------------------------
     A          R SFLCTL1                   SFLCTL(SFL1)
     A                                      SFLSIZ(0019)
     A                                      SFLPAG(0019)
     A                                      OVERLAY
     A  30                                  SFLDSP
     A                                      SFLDSPCTL
     A N30                                  SFLCLR
     A  29                                  SFLEND(*MORE)
     A                                  1  2'SRCDIFF'
     A                                      COLOR(BLU)
     A                                  1 56'Source Member Compare'
     A                                      DSPATR(HI)
     A                                  1115DATE
     A                                      EDTCDE(Y)
     A                                      COLOR(BLU)
     A                                  1125TIME
     A                                      COLOR(BLU)
     A                                  2  2'Old . . :'
     A                                      COLOR(BLU)
     A            OLDNAM        33A  O  2 12
     A                                      COLOR(RED)
     A                                  2 72'Context . . . :'
     A                                      COLOR(BLU)
     A            CTXTXT         5A  O  2 88
     A                                  2 96'Ignore blanks . :'
     A                                      COLOR(BLU)
     A            IGNTXT         3A  O  2114
     A                                  3  2'New . . :'
     A                                      COLOR(BLU)
     A            NEWNAM        33A  O  3 12
     A                                      COLOR(GRN)
     A                                  3 72'Result  . . . :'
     A                                      COLOR(BLU)
     A            STATS         36A  O  3 88
     A                                      COLOR(YLW)
     A                                  4  2'Go to seq . . .'
     A                                      COLOR(BLU)
     A            GOTOSEQ        6Y 2B  4 18EDTCDE(4)
     A                                      DSPATR(UL)
     A            POSTXT        40A  O  4 72
     A                                      COLOR(BLU)
     A                                  5  7'Old#    New# Source'
     A                                      COLOR(BLU)
     A                                      DSPATR(UL)
     A*---------------------------------------------------------------
     A* Footer: message line and function keys
     A*---------------------------------------------------------------
     A          R FOOTER
     A                                      OVERLAY
     A            MSG          100A  O 26  2
     A                                      COLOR(PNK)
     A                                 27  2'F3=Exit   F6=Whole/Hunks   F10=Nex-
     A                                      t change   F11=Previous change   F-
     A                                      14=Ignore blanks   F16=Top   F17=B-
     A                                      ottom   F12=Cancel'
     A                                      COLOR(BLU)
